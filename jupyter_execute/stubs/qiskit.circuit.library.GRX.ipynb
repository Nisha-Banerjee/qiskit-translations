iteral.String.Heredoc */\n.highlight .si { color: #7f0000 } /* Literal.String.Interpol */\n.highlight .sx { color: #7f0000 } /* Literal.String.Other */\n.highlight .sr { color: #7f0000 } /* Literal.String.Regex */\n.highlight .s1 { color: #7f0000 } /* Literal.String.Single */\n.highlight .ss { color: #7f0000 } /* Literal.String.Symbol */\n.highlight .bp { color: #00007f } /* Name.Builtin.Pseudo */\n.highlight .fm { color: #7f7fe0 } /* Name.Function.Magic */\n.highlight .il { color: #007f7f } /* Literal.Number.Integer.Long */\n    </style>\n    <div class=\"highlight\"><pre><span></span><span class=\"kr\">OPENQASM</span><span class=\"err\"> </span><span class=\"m\">2</span><span class=\"err\">.</span><span class=\"m\">0</span><span class=\"err\">;</span>\n<span class=\"kr\">include</span><span class=\"s\"> &quot;qelib1.inc&quot;</span><span class=\"err\">;</span>\n<span class=\"nf\">gate</span><span class=\"err\"> </span><span class=\"kt\">r</span><span class=\"err\">(p</span><span class=\"kt\">ara</span><span class=\"err\">m</span><span class=\"kt\">0</span><span class=\"err\">,p</span><span class=\"kt\">ara</span><span class=\"err\">m</span><span class=\"kt\">1</span><span class=\"err\">) q</span><span class=\"kt\">0</span><span class=\"err\"> { </span><span class=\"kt\">u3</span><span class=\"err\">(p</span><span class=\"kt\">i</span><span class=\"err\">/</span><span class=\"kt\">4</span><span class=\"err\">,-p</span><span class=\"kt\">i</span><span class=\"err\">/</span><span class=\"kt\">2</span><span class=\"err\">,p</span><span class=\"kt\">i</span><span class=\"err\">/</span><span class=\"kt\">2</span><span class=\"err\">) q</span><span class=\"kt\">0</span><span class=\"err\">; }</span>\n<span class=\"nf\">gate</span><span class=\"err\"> GR(</span><span class=\"kt\">0</span><span class=\"err\">.</span><span class=\"kt\">79</span><span class=\"err\">, </span><span class=\"kt\">0</span><span class=\"err\">.</span><span class=\"kt\">00</span><span class=\"err\"