       "value": "<table><style>\ntable {\n    font-family: \"IBM Plex Sans\", Arial, Helvetica, sans-serif;\n    border-collapse: collapse;\n    width: 100%;\n    border-left: 2px solid #212121;\n}\n\nth {\n    text-align: left;\n    padding: 5px 5px 5px 5px;\n    width: 100%;\n    background-color: #988AFC;\n    color: #fff;\n    font-size: 14px;\n    border-left: 2px solid #988AFC;\n}\n\ntd {\n    text-align: left;\n    padding: 5px 5px 5px 5px;\n    width: 100%;\n    font-size: 12px;\n    font-weight: medium;\n}\n\ntr:nth-child(even) {background-color: #f6f6f6;}\n</style><tr><th>QPE</th><th></tr><tr><td>Width</td><td>5</td></tr><tr><td>Depth</td><td>1</td></tr><tr><td>Total Gates</td><td>1</td></tr><tr><td>Non-local Gates</td><td>1</td></tr></table>"
